# Copy to .env.local and fill in your own values.
# .env.local is gitignored — never commit real credentials.

# Reddit requires a descriptive, unique User-Agent on every API request.
# Format: <platform>:<app-id>:<version> (by /u/<your-reddit-username>)
# See https://github.com/reddit-archive/reddit/wiki/API#rules
REDDIT_USER_AGENT="web:subreddit-vibe-check:v0.1.0 (by /u/your-username)"
