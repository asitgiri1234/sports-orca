# Copy to .env.local and fill in your own values.
# .env.local is gitignored - never commit real credentials.

# Reddit requires a descriptive, unique User-Agent on every API request.
# Format: <platform>:<app-id>:<version> (by /u/<your-reddit-username>)
# See https://github.com/reddit-archive/reddit/wiki/API#rules
REDDIT_USER_AGENT="web:subreddit-vibe-check:v0.1.0 (by /u/your-username)"

# OAuth app-only (client_credentials) credentials.
#
# Without these the app falls back to the unauthenticated endpoint, which
# Reddit blocks from most datacenter IPs (and increasingly from residential
# ones) with a 403 "Blocked" HTML page. Set them for anything deployed.
#
# To create them:
#   1. Sign in and go to https://www.reddit.com/prefs/apps
#   2. "create another app..." and choose type "script"
#   3. redirect uri can be http://localhost:3000 (unused for app-only auth)
#   4. CLIENT_ID is the string under the app name; CLIENT_SECRET is "secret"
#
# These are secrets. Keep them in .env.local only.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
